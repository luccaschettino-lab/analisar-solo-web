# Copie para .env e preencha com os valores do seu projeto Supabase.
# O .env é ignorado pelo git. Salve como UTF-8 SEM BOM — o BOM entra no nome
# da primeira variável e ela chega undefined no Vite.
#
# Onde achar: Dashboard > Project Settings > API Keys.
#
# Use a publishable key (formato sb_publishable_...), não a anon key JWT
# legada. As duas funcionam, mas a publishable é o formato atual e pode ser
# rotacionada sem invalidar os tokens de sessão já emitidos.
#
# Esta chave é pública por natureza: vai embutida no bundle do navegador.
# A segurança real está na RLS do banco, não em escondê-la.
# Nunca coloque aqui a service_role key nem uma sb_secret_.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE
